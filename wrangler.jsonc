{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The deploy job overrides the name with the repo name (--name).
  "name": "startup-project-template",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // The SPA is static assets (free, no Worker CPU). The Worker only runs for the API and /health.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "ai": { "binding": "AI" },
  // Per-visitor limit (AD-7). namespace_id is any account-unique integer string.
  "ratelimits": [
    { "name": "VISITOR_LIMIT", "namespace_id": "7001", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "DAILY_LLM_CAP": "200",
    "GIT_SHA": "dev"
  }
  // Secrets (wrangler secret put, deploy job only): DATABASE_URL, GROQ_API_KEY, OPENROUTER_API_KEY.
  // Optional var AI_GATEWAY_ID routes Workers AI through an AI Gateway for exact-match caching.
}
